{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:codegen": "node --env-file-if-exists=../../.env node_modules/kysely-codegen/dist/cli/bin.js --dialect postgres --out-file src/db/types.ts --camel-case --runtime-enums false --exclude-pattern \"atlas_schema_revisions.*\"",
    "db:seed": "node --env-file-if-exists=../../.env src/db/seed.ts"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@fastify/cors": "11.4.1",
    "@fastify/sensible": "6.0.7",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "csv-parse": "7.0.3",
    "fastify": "5.12.8",
    "fastify-plugin": "5.1.0",
    "fastify-type-provider-zod": "7.0.0",
    "kysely": "0.29.8",
    "pg": "8.23.1",
    "ts-fsrs": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "kysely-codegen": "0.20.0",
    "vitest": "5.1.0"
  }
}
