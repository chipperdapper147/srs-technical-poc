    "@jest/globals": "30.5.2",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "react-dom": "19.3.1",
    "react-native-web": "0.21.4",
    "test-renderer": "1.3.0"
