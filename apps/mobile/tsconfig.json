{
  "extends": "../../tsconfig.base.json",
  // No "DOM" lib and no Node types: only React Native's globals (fetch, timers, performance).
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "customConditions": ["react-native"],
    "jsx": "react-jsx",
    "types": [],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["index.ts", "src"]
}
