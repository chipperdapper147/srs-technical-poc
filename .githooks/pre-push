#!/usr/bin/env bash
# Block pushing commits whose messages link to a Claude session, including
# commits that never went through commit-msg (cherry-picks, --no-verify).
set -euo pipefail
check="$(git rev-parse --show-toplevel)/scripts/check-commit-messages.sh"

while read -r _local_ref local_sha _remote_ref remote_sha; do
  if [[ $local_sha =~ ^0+$ ]]; then continue; fi # deleting a remote branch
  if [[ $remote_sha =~ ^0+$ ]] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    "$check" "$local_sha" --not --remotes # new branch, or remote tip unknown locally
  else
    "$check" "$remote_sha..$local_sha"
  fi
done

# Verification obligations: behaviour changes must ship with a test change or
# a `Verify-Waive: <id>: <reason>` trailer (docs/verification.md). Instant, git only.
if git rev-parse --verify --quiet origin/main >/dev/null; then
  node "$(git rev-parse --show-toplevel)/scripts/verify/cli.ts" obligations --committed >/dev/null || {
    echo "pre-push: verification obligations not met. See: pnpm verify obligations --committed" >&2
    exit 1
  }
fi
