{
  "name": "srs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "test": "turbo run test && pnpm test:scripts",
    "test:scripts": "node --test 'scripts/**/*.test.ts'",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "node scripts/verify/cli.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:diff": "./scripts/with-env.sh atlas migrate diff --env local",
    "db:migrate": "./scripts/with-env.sh atlas migrate apply --env local",
    "db:check": "./scripts/db-check.sh",
    "db:lint": "node scripts/schema/lint-migrations.ts",
    "db:rehearse": "node scripts/schema/rehearse.ts",
    "db:hash": "./scripts/with-env.sh atlas migrate hash --env local",
    "db:codegen": "pnpm --filter @app/api db:codegen",
    "db:seed": "pnpm --filter @app/api db:seed",
    "api:openapi": "pnpm --filter @app/api openapi",
    "design:build": "pnpm --filter @app/design build",
    "design:system": "pnpm --filter @app/design system",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "e2e": "pnpm --filter @app/e2e e2e",
    "e2e:scratch": "pnpm --filter @app/e2e e2e:scratch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "squawk-cli": "2.70.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
