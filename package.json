{
  "name": "srs",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:diff": "atlas migrate diff --env local",
    "db:migrate": "atlas migrate apply --env local",
    "db:check": "./scripts/db-check.sh",
    "db:codegen": "pnpm --filter @app/api db:codegen",
    "db:seed": "pnpm --filter @app/api db:seed",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
