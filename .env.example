# Postgres from docker-compose.yml
DATABASE_URL=postgres://srs:srs@localhost:5432/srs?sslmode=disable
# Separate database used by the API integration tests (created by docker/init-test-db.sql)
TEST_DATABASE_URL=postgres://srs:srs@localhost:5432/srs_test?sslmode=disable

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Shared key the API requires as `Authorization: Bearer <key>` (stopgap until
# Auth0). Leave unset locally; required on every Vercel deploy.
# API_ACCESS_KEY=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Neon (the deployed database) is deliberately NOT configured here, so local
# dev, seeds and tests never touch it. `neon env pull --file .env.neon` writes
# DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct, for migrations)
# into the git-ignored .env.neon. Use them explicitly, e.g.
#   set -a; . ./.env.neon; set +a; pnpm db:migrate
