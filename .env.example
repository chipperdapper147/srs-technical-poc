# Postgres from docker-compose.yml
DATABASE_URL=postgres://srs:srs@localhost:5432/srs?sslmode=disable
# Separate database used by the API integration tests (created by docker/init-test-db.sql)
TEST_DATABASE_URL=postgres://srs:srs@localhost:5432/srs_test?sslmode=disable

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Auth: `dev` (the default) needs no Auth0: every request is the local learner,
# or the user named by the `x-dev-user` header. Production runs `jwt`, which
# verifies Auth0 access tokens and needs AUTH0_DOMAIN and AUTH0_AUDIENCE.
# AUTH_MODE=dev
# AUTH0_DOMAIN=hallavo.eu.auth0.com
# AUTH0_AUDIENCE=https://srs-technical-poc.vercel.app

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
# Sign-in through Auth0. Leave unset locally (and in e2e): the web then runs a
# dev auth port, with no login, against an API in dev mode.
# NEXT_PUBLIC_AUTH0_DOMAIN=hallavo.eu.auth0.com
# NEXT_PUBLIC_AUTH0_CLIENT_ID=XH7eWzd8b4tJ0XD6ILTFTxu926BbYw5x
# NEXT_PUBLIC_AUTH0_AUDIENCE=https://srs-technical-poc.vercel.app

# Neon (the deployed database) is deliberately NOT configured here, so local
# dev, seeds and tests never touch it. `neon env pull --file .env.neon` writes
# DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct, for migrations)
# into the git-ignored .env.neon. Use them explicitly, e.g.
#   set -a; . ./.env.neon; set +a; pnpm db:migrate
