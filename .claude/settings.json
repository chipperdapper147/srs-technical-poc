{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "sessionUrl": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks"
          }
        ]
      }
    ]
  }
}
